#!/usr/bin/env bash
# tests/fake-herdr — a stub herdr binary for tests/run.sh.
#
# The entrypoint resolves herdr through ${HERDR_BIN_PATH:-herdr}, so pointing that
# variable at this file is the whole mechanism: no real multiplexer, no sockets,
# no state. Every call the entrypoint makes is recorded, which is the only way to
# assert on the *command sequence* a terminal-multiplexer plugin performs.
#
# What it does, per invocation:
#   1. appends one line to $FAKE_HERDR_LOG (TAB-separated argv fields, in order)
#   2. prints a response on stdout, chosen by subcommand
#   3. exits 0, unless failure injection (below) matches this invocation
#
# ---- RESPONSES: captured fixtures only --------------------------------------
# Every herdr response served here comes from tests/fixtures/, captured live by
# issue #7. That work settled the one fact PLAN.md §3 called explicitly
# unverified: the new pane id is at `.result.pane.pane_id`, the same envelope as
# `pane get`; the plausible alternative `.result.pane_id` yields `null`. Note also
# that `result.type` in the split response is `pane_info`, NOT `pane_split` —
# which is why nothing in this stub branches on `result.type`. Responses are keyed
# off the argv this stub receives, which is what it logs anyway.
#
# There is deliberately no hand-written herdr response left in this file. An
# earlier version carried inline placeholders, and they were removed once the
# real captures landed and made them unreachable. A fabricated response encodes a
# field layout that may not exist, and a suite that passes against a fiction is
# worse than a suite that fails loudly. If a fixture is missing, this stub says so
# and exits non-zero rather than inventing one.
#
# tests/fixtures/** is owned by another member (issue #7) and is read-only here.
#
# The single exception is `pane run`, whose response is a constant: the entrypoint
# checks only its exit status and never parses its body, so there is nothing to be
# faithful about. It is labelled inline rather than dressed up as a capture.
#
# ---- KNOB PRECEDENCE: never silent ------------------------------------------
# The source pane and cwd are dimensions the tests own, so an explicitly-set knob
# wins. Rather than swapping in a hand-written response, the *captured* response
# is kept and only the fields the knob names are substituted — the response keeps
# its real, proven shape while the value becomes the test's. Every substitution
# is announced on stderr, because the rule is that no override is quiet: a knob
# the system ignores without complaint is how a suite ends up green while
# asserting about a world it no longer controls.
#
# `pane split` is the exception that proves the rule: its new pane id is the one
# value that must never be faked, so the captured fixture always wins, knob or not,
# and run.sh derives the expected id by querying the fixture rather than
# hard-coding it — a re-capture cannot silently invalidate the expectation.
#
# `${VAR+x}` tests *set-ness*, not non-emptiness, so an intentionally empty knob
# is still honoured.
#
# ---- FAULT INJECTION: one list, not one variable per fault -------------------
# FAKE_HERDR_FAULT is a comma-separated list of response faults. Earlier
# revisions used a boolean per fault, which meant every added case brought a new
# environment variable, a new convention in run.sh, and another line of prose to
# keep true. One list keeps the surface flat however many faults exist.
#
#   split-echoes-source   the split response names the SOURCE pane as the new
#                         one — the pane the user is typing in, which must
#                         never be typed into
#   current-no-pane-id    `pane current` succeeds but carries no pane id
#   split-null-pane-id    the split response's pane id is JSON null, not ""
#   split-no-pane-id      the split response's pane id is blank
#   split-id-not-string   the split response's pane id is a JSON number, not a
#                         string, so `jq -r` renders it without quotes and the
#                         entrypoint cannot tell an id from a count
#   split-id-unsafe-chars the split response's pane id contains characters
#                         outside [A-Za-z0-9_.:-] — e.g. a space and a semicolon,
#                         the shape a mis-parsed response would produce
#   split-id-no-colon     the split response's pane id is well-formed but has no
#                         colon, so it is not a pane id at all
#   agent-get-empty       `agent get` succeeds but records no agent_status, i.e.
#                         the pane is not registered yet. NOT the same defect as
#                         agent-session-dropped: this one models a pane herdr has
#                         never registered, that one models a registration whose
#                         session identity was accepted and thrown away.
#   agent-get-no-pane     `agent get` returns a registered agent carrying no
#                         pane_id, as herdr does for a name that resolves to
#                         nothing. For issue #74, where a name argument is
#                         resolved to a pane before anything can be driven.
#   agent-session-dropped `pane report-agent-session` exits 0 and persists
#                         nothing, so the later `agent get` reports
#                         agent_session: null. This is herdr 0.9.3's MEASURED
#                         behaviour for an agent kind it does not enumerate —
#                         see the provenance note on emit_agent_get.
#   report-agent-session-unsupported
#                         a Herdr with no `pane report-agent-session` verb
#
# Every fault is a *variant of the real capture*: jq rewrites one field and leaves
# the envelope, id, type, scroll and every other field exactly as herdr produced
# them. No fault invents a pane id, because a hand-written id would let the suite
# pass against something herdr never returns.
#
# A fault is announced on stderr when it applies, like the knob substitutions
# above: nothing this stub does to a response is quiet.
#
# Separately, FAKE_HERDR_FAIL injects non-zero *exit statuses* and is already a
# list. Together they cover both halves of a faulty CLI: the calls that fail, and
# the calls that succeed with the wrong content.
#
# Test-only knobs:
#   FAKE_HERDR_LOG        file to append the invocation log to (required)
#   FAKE_HERDR_FIXTURES   fixture directory (default: <repo>/tests/fixtures)
#   FAKE_HERDR_FAIL       "<subcommand>[:<exit-code>]", e.g. "pane split:1".
#                         Comma-separated; matched against the first two argv
#                         fields, so "pane split" fails only the split call.
#   FAKE_HERDR_FAULT      comma-separated response faults, listed above
#   FAKE_HERDR_CWD        cwd substituted into `pane get` / `pane current`
#   FAKE_HERDR_SRC_PANE   pane id substituted into `pane get` / `pane current`
#   FAKE_HERDR_SESSION_STATE
#                         file the stub remembers a reported session id in
#                         (default: "$FAKE_HERDR_LOG.session", so every case is
#                         isolated and dies with its own sandbox)

set -euo pipefail

# --- invocation log ----------------------------------------------------------
# One line per invocation, argv fields joined by TAB. TAB rather than a space so
# an argument containing a space (a --cwd path) stays unambiguously parseable.
# Refusing to log is a bug in the test, not something to paper over.
#
# `--self-check` is introspection: it prints the responses it would serve and
# touches no log, so it is exempt from the FAKE_HERDR_LOG requirement below.
if [ "${1:-}" != "--self-check" ]; then
  if [ -z "${FAKE_HERDR_LOG:-}" ]; then
    printf 'fake-herdr: FAKE_HERDR_LOG is not set\n' >&2
    exit 64
  fi
  {
    sep=''
    for arg in "$@"; do
      printf '%s%s' "$sep" "$arg"
      sep=$'\t'
    done
    printf '\n'
  } >>"$FAKE_HERDR_LOG"
fi

# --- failure injection -------------------------------------------------------
sub="${1:-} ${2:-}"
sub="${sub% }"
if [ -n "${FAKE_HERDR_FAIL:-}" ]; then
  IFS=',' read -r -a wanted <<<"$FAKE_HERDR_FAIL"
  for w in "${wanted[@]}"; do
    [ -z "$w" ] && continue
    case "$w" in
      *:*) want_sub="${w%:*}"; want_code="${w##*:}" ;;
      *)   want_sub="$w"; want_code=1 ;;
    esac
    if [ "$sub" = "$want_sub" ]; then
      # The marker matters: the entrypoint's own diagnostics also contain the
      # subcommand name, so a test asserting on that text cannot tell the
      # entrypoint's message from this one being relayed. This token appears only
      # here, so its presence in the entrypoint's stderr proves the relay happened.
      printf 'fake-herdr: injected failure for "%s" (exit %s) [%s]\n' \
        "$sub" "$want_code" "${FAKE_HERDR_STUB_MARKER:-herdr-stub-failure}" >&2
      exit "$want_code"
    fi
  done
fi

# --- response resolution -----------------------------------------------------
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
fixtures="${FAKE_HERDR_FIXTURES:-$here/fixtures}"

src_pane="${FAKE_HERDR_SRC_PANE:-wZ:p1}"
# Normalised, so a default cwd never leaks a trailing "/.." into a --cwd value.
src_cwd="${FAKE_HERDR_CWD:-$(cd -- "$here/.." && pwd)}"

faults=",${FAKE_HERDR_FAULT:-},"

# Membership test on the comma-separated fault list. The list is wrapped in
# commas on both sides so `split-no-pane-id` cannot match as a substring of some
# longer name.
has_fault() { # has_fault <name>
  case "$faults" in
    *",$1,"*) return 0 ;;
  esac
  return 1
}

announce_fault() { # announce_fault <name> <what-it-did>
  printf 'fake-herdr: FAKE_HERDR_FAULT=%s — %s\n' "$1" "$2" >&2
}

# --- remembered session identity ---------------------------------------------
# A real multiplexer REMEMBERS: `pane report-agent-session` writes, and a later
# `agent get` reads back what was written. This stub is a fresh process per
# invocation, so "remembers" has to be a file. It hangs off the invocation log's
# own path, so each test case gets its own memory and loses it with its sandbox —
# no shared state, no cleanup hook, nothing to leak between cases.
#
# Both calls are no-ops in --self-check mode, which touches no state at all.
session_state_file() { # session_state_file
  # Nothing to hang state off means there is no state to keep — the --self-check
  # path sets neither variable. Returning empty here stops that path from
  # degrading to a bare ".session" in whatever the caller's cwd happens to be,
  # where it could pick up a stray file and make introspection lie.
  [ -n "${FAKE_HERDR_SESSION_STATE:-}${FAKE_HERDR_LOG:-}" ] || return 0
  printf '%s' "${FAKE_HERDR_SESSION_STATE:-${FAKE_HERDR_LOG:-}.session}"
}

remember_session_id() { # remember_session_id <id>
  local f
  f="$(session_state_file)" || return 0
  [ -n "$f" ] || return 0
  printf '%s\n' "$1" >"$f"
}

remembered_session_id() { # prints the remembered id, or nothing at all
  local f
  f="$(session_state_file)" || return 0
  [ -n "$f" ] && [ -f "$f" ] || return 0
  cat "$f"
}

# `agent get` — the one response here that is PARSED, and the one that carries
# the session identity the read-back cases assert on.
#
# PROVENANCE, because this file's rule is that nothing is invented. The
# `agent_session` shape below is MEASURED, not guessed. Captured 2026-10-04 from
# herdr 0.9.3 with:
#
#   herdr agent list | grep -o '"agent_session":{[^}]*}'
#
# which returned, for a pane that carries a session:
#
#   "agent_session":{"agent":"claude","kind":"id","source":"herdr:claude",
#                    "value":"94929c8f-8704-4834-9b31-30c53c001c89"}
#
# So the session id lives at `.result.agent.agent_session.value`. It is NOT at
# `.result.agent.agent_session` — that is the wrapper object, and it is exactly
# how a read-back can appear to succeed while proving nothing: a non-null
# wrapper says nothing about whether the id that was sent is the id that landed.
# Issue #71's `jq -r '.result.agent.agent_session'` printed `null` because herdr
# had discarded the write, not because the field is a bare scalar.
#
# The two shapes this can serve are both real:
#   * key ABSENT      — herdr 0.9.3 on an mcode pane after an accepted-and-
#                       discarded session report, the measured behaviour, and
#                       what agent-session-dropped forces
#   * value: <id>     — a herdr that persisted what it was told, which is what
#                       lets a suite prove the read-back DETECTS a write that
#                       landed instead of only ever firing on a write that failed
#
# Absent, not `"agent_session": null`. Both make `.result.agent.agent_session.value`
# read as null, so a jq path cannot tell them apart — but they are not the same
# response, and a stub that serves the wrong one is a stub encoding a fiction.
# The key is omitted from the document entirely when herdr holds no session.
#
# The `agent`/`agent_status` fields around it are the minimum this stub has
# always served; they predate the captures and are not themselves a capture.
#
# ---- pane_id AND cwd, added for issue #74 ------------------------------------
# A real `herdr agent get` returns both, which is how a name is resolved to a
# pane and a pane to its working directory. Measured on herdr 0.9.3, 2026-10-04:
#
#   {"id":"cli:agent:get","result":{"agent":{"agent":"claude",
#     "agent_session":{…},"agent_status":"working",
#     "cwd":"/Users/noonoon/Dev/herdr-plugin-minimax-code","focused":true,
#     "foreground_cwd":"…","pane_id":"wZ:p3","revision":4,
#     "state_change_seq":88,"tab_id":"wZ:t3","terminal_id":"term_…",
#     "terminal_title":"◑ Repo overview","workspace_id":"wZ"},"type":"agent_info"}}
#
# Sourced from the SAME FAKE_HERDR_SRC_PANE / FAKE_HERDR_CWD knobs `pane get` and
# `pane current` already use, rather than a second pair. One pane id and one cwd
# per case is the point: a test that could set them independently for `agent get`
# and `pane get` could assert a coherent story that no real multiplexer would ever
# produce.
#
# Additive, and verified not to disturb the four existing suites: bin/mcode-session.sh
# reads only `.result.agent.agent_status` and `.result.agent.agent_session.value` from
# this response, and tests/session-run.sh asserts on logged ARGV rather than on the
# response body. The `agent-get-empty` fault still short-circuits to a bare agent
# object, which is what issue #35's cases depend on.
emit_agent_get() { # emit_agent_get
  local sid
  sid="$(remembered_session_id)"
  if [ -n "$sid" ]; then
    jq -cn --arg s "$sid" --arg p "$src_pane" --arg c "$src_cwd" '{
      result: {
        agent: {
          agent: "mcode",
          agent_status: "working",
          cwd: $c,
          pane_id: $p,
          agent_session: {agent: "minimax-code", kind: "id",
                          source: "herdr:minimax-code", value: $s}
        },
        type: "agent_info"
      }
    }'
  else
    # No agent_session key at all — del() is what makes this an absence rather
    # than a field set to null.
    jq -cn --arg p "$src_pane" --arg c "$src_cwd" '{
      result: {
        agent: {agent: "mcode", agent_status: "working",
                cwd: $c, pane_id: $p, agent_session: null},
        type: "agent_info"
      }
    } | del(.result.agent.agent_session)'
  fi
}

fixture_path() { # fixture_path <name>; prints the path, or exits non-zero
  local file="$fixtures/$1.json"
  if [ ! -f "$file" ]; then
    printf 'fake-herdr: missing fixture %s\n' "$file" >&2
    printf 'fake-herdr: run from a checkout with tests/fixtures/ populated (issue #7)\n' >&2
    exit 64
  fi
  if ! command -v jq >/dev/null 2>&1; then
    printf 'fake-herdr: jq is required to serve the captured fixture %s\n' "$file" >&2
    exit 64
  fi
  printf '%s' "$file"
}

# `pane get` and `pane current`: the captured response, with the knob-owned
# fields substituted when a knob is set. See KNOB PRECEDENCE above.
emit_pane_info() { # emit_pane_info <fixture-name>
  local name="$1"
  local file
  file="$(fixture_path "$name")"
  if [ "$name" = "pane-current" ] && has_fault current-no-pane-id; then
    announce_fault current-no-pane-id "blanking the pane id in the captured $name response"
    jq -c '.result.pane.pane_id = ""' "$file"
  elif [ -n "${FAKE_HERDR_CWD+x}" ] || [ -n "${FAKE_HERDR_SRC_PANE+x}" ]; then
    printf 'fake-herdr: knob set, substituting pane_id/cwd into the captured %s response\n' \
      "$name" >&2
    jq -c --arg p "$src_pane" --arg c "$src_cwd" \
      '.result.pane.pane_id = $p | .result.pane.cwd = $c' "$file"
  else
    jq -c '.' "$file"
  fi
}

# `pane split`: the captured response, or a one-field variant of it.
emit_split() { # emit_split
  local file
  file="$(fixture_path pane-split)"
  if has_fault split-echoes-source; then
    # The source pane is substituted, never invented: the scenario is that the
    # response layout changed and we misread it, so the split "new pane" is the
    # pane the user is already in. The captured envelope is untouched.
    announce_fault split-echoes-source "pointing the split response at the source pane $src_pane"
    jq -c --arg p "$src_pane" '.result.pane.pane_id = $p' "$file"
  elif has_fault split-null-pane-id; then
    announce_fault split-null-pane-id "setting the split response's pane id to JSON null"
    jq -c '.result.pane.pane_id = null' "$file"
  elif has_fault split-no-pane-id; then
    announce_fault split-no-pane-id "blanking the pane id in the captured split response"
    jq -c '.result.pane.pane_id = ""' "$file"
  elif has_fault split-id-not-string; then
    announce_fault split-id-not-string "setting the split response's pane id to a JSON number"
    jq -c '.result.pane.pane_id = 42' "$file"
  elif has_fault split-id-unsafe-chars; then
    announce_fault split-id-unsafe-chars "setting the split response's pane id to a value with characters outside [A-Za-z0-9_.:-]"
    jq -c --arg p 'wZ:p8; echo pwned' '.result.pane.pane_id = $p' "$file"
  elif has_fault split-id-no-colon; then
    announce_fault split-id-no-colon "setting the split response's pane id to a colon-less value"
    jq -c '.result.pane.pane_id = "wZp8"' "$file"
  else
    jq -c '.' "$file"
  fi
}

emit_agent_list() { # emit_agent_list
  # The entrypoint calls `agent list` only to learn which agent names are already
  # taken, and reads nothing else from it. There is no captured fixture for this
  # verb, so the shape is the minimum that can answer that question and is
  # labelled here rather than dressed up as a capture.
  if has_fault agent-names-taken; then
    announce_fault agent-names-taken "reporting mcode and mcode-2 as already named"
    printf '%s\n' '{"result":{"agents":[{"agent":"mcode","name":"mcode","pane_id":"wZ:p9"},{"agent":"mcode","name":"mcode-2","pane_id":"wZ:p7"}],"type":"agent_list"}}'
  else
    printf '%s\n' '{"result":{"agents":[],"type":"agent_list"}}'
  fi
}

if [ "${1:-}" = "--self-check" ]; then
  printf 'pane-get\t%s\n'     "$(emit_pane_info pane-get)"
  printf 'pane-current\t%s\n' "$(emit_pane_info pane-current)"
  printf 'pane-split\t%s\n'   "$(jq -c '.' "$(fixture_path pane-split)")"
  # Not a capture, and never parsed by the entrypoint. Labelled, not disguised.
  printf 'pane-run\t%s\n'     '{"result":{"ok":true}}'
  printf 'pane-report-agent\t%s\n' '{"result":{"ok":true}}'
  printf 'pane-report-agent-session\t%s\n' '{"result":{"ok":true}}'
  printf 'agent-get\t%s\n' "$(emit_agent_get)"
  printf 'agent-list\t%s\n'   '{"result":{"agents":[],"type":"agent_list"}}'
  printf 'agent-rename\t%s\n' '{"result":{"agent":{"agent":"mcode","name":"mcode"},"type":"agent_renamed"}}'
  exit 0
fi

case "$sub" in
  "pane get")
    emit_pane_info pane-get
    ;;
  "pane current")
    emit_pane_info pane-current
    ;;
  "pane split")
    emit_split
    ;;
  "pane run")
    # The entrypoint checks this call's exit status only and never reads its
    # body, so there is no captured shape to be faithful to here.
    printf '%s\n' '{"result":{"ok":true}}'
    ;;
  "pane report-agent")
    # Same as `pane run`: exit status only, body never parsed. The
    # report-agent-unsupported fault models an older Herdr that has no such
    # verb at all, which is a different failure from a verb that errors.
    if has_fault report-agent-unsupported; then
      announce_fault report-agent-unsupported "behaving as a Herdr with no report-agent verb"
      printf 'fake-herdr: unhandled subcommand: %s\n' "${1:-}" >&2
      exit 64
    fi
    printf '%s\n' '{"result":{"ok":true}}'
    ;;
  "agent get")
    # PARSED, unlike the report/rename verbs below. bin/mcode-session.sh reads
    # the status herdr already records for the pane so it can re-assert it
    # instead of imposing a placeholder that would overwrite a real one.
    # agent-get-empty models a pane herdr has not registered yet, which is the
    # launch-path case and the only one where the script picks a state itself.
    # It is a DIFFERENT defect from agent-session-dropped: an unregistered pane
    # versus a registered pane whose session identity was accepted and dropped.
    if has_fault agent-get-empty; then
      announce_fault agent-get-empty "reporting a pane with no recorded agent state"
      printf '%s\n' '{"result":{"agent":{},"type":"agent_info"}}'
      exit 0
    fi
    # A name that resolves to nothing. Distinct from both other agent-get faults:
    # the pane is registered and the state is there, but there is no pane_id to
    # resolve a NAME to — which is what an implementation must notice rather than
    # exec against an empty pane argument.
    if has_fault agent-get-no-pane; then
      announce_fault agent-get-no-pane "returning an agent with no pane_id, as herdr does for a name that resolves to nothing"
      jq -cn --arg c "$src_cwd" \
        '{result:{agent:{agent:"mcode",agent_status:"working",cwd:$c},type:"agent_info"}}'
      exit 0
    fi
    emit_agent_get
    ;;
  "agent list")
    emit_agent_list
    ;;
  "pane report-agent-session")
    # Exit status is what the entrypoint checks, on the same grounds as
    # `pane run`: the session id and the resume command are arguments, and
    # arguments are already in the log the tests assert on.
    # report-agent-session-unsupported models a Herdr that has no such verb, a
    # different failure from one that errors.
    if has_fault report-agent-session-unsupported; then
      announce_fault report-agent-session-unsupported "behaving as a Herdr with no report-agent-session verb"
      printf 'fake-herdr: unhandled subcommand: %s\n' "${1:-}" >&2
      exit 64
    fi
    # What a persisting herdr would keep, so a later `agent get` can serve it
    # back. agent-session-dropped is the fault that models 0.9.3 instead: the
    # call is accepted, exits 0, and nothing is written anywhere. That silence
    # is the whole defect of issue #71 — a write that reports success and
    # changes nothing — so it is modelled by NOT remembering, never by failing.
    if has_fault agent-session-dropped; then
      announce_fault agent-session-dropped \
        "accepting the session report, exiting 0 and persisting nothing, as herdr 0.9.3 does for agent kinds it does not enumerate"
    else
      while [ "$#" -gt 0 ]; do
        if [ "$1" = "--agent-session-id" ] && [ "$#" -ge 2 ]; then
          remember_session_id "$2"
          break
        fi
        shift
      done
    fi
    printf '%s\n' '{"result":{"ok":true}}'
    ;;
  "agent rename")
    # Also exit-status only. The name the entrypoint chose is in the log, which
    # is what the tests assert on.
    printf '%s\n' '{"result":{"agent":{"agent":"mcode","name":"mcode"},"type":"agent_renamed"}}'
    ;;
  *)
    printf 'fake-herdr: unhandled subcommand: %s\n' "${1:-<none>} ${2:-}" >&2
    exit 64
    ;;
esac
